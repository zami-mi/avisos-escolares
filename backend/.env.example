# Base de datos MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=tu_contraseña_aqui
DB_NAME=avisos_escolares
DB_PORT=3306

# Proveedor de datos activo: mysql
DATA_PROVIDER=mysql

# Configuración de SSL para MySQL:
# - DB_SSL_MODE: 'disabled' (sin SSL), 'required' (forzar SSL).
#   Por defecto: 'disabled' si DB_HOST es localhost/127.0.0.1; 'required' si es remoto (ej. Render/Aiven/AWS).
# DB_SSL_MODE=disabled

# - DB_CA_PATH: Ruta al certificado CA de la base de datos remota (por defecto busca 'certs/ca.pem').
# DB_CA_PATH=certs/ca.pem

# - DB_CA_CERT: Contenido PEM del certificado CA como string (alternativa útil en variables de Render).
# DB_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# - DB_SSL_REJECT_UNAUTHORIZED: 'true' (validación estricta del certificado, recomendado) o 'false'.
#   Por defecto es 'true' cuando se suministra certificado CA.
# DB_SSL_REJECT_UNAUTHORIZED=true

# Configuración del servicio de correo para notificación a familias (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_email_emisor@gmail.com
SMTP_PASS=tu_token_o_app_password
EMAIL_FROM="Sistema de Avisos Escolares <notificaciones@escuela.com>"
